  "keyFeatures": [
    "Lightweight HTTP/HTTPS proxy with minimal resource consumption",
    "Access control lists (ACL) with IP address and domain-based rules",
    "URL and domain filtering with regex (BRE/ERE) and fnmatch support",
    "Upstream proxy chaining with HTTP, SOCKS4, and SOCKS5 support",
    "Transparent proxy mode via firewall redirection",
    "Reverse proxy support for aggregating multiple sites",
    "HTTP Basic Authentication for proxy access",
    "Anonymous proxying mode with selective header forwarding",
    "Built-in statistics page (StatHost)",
    "Configurable logging to file or syslog",
    "Connection buffering for improved client performance"
  ],
  "publicApiSurface": [
    "tinyproxy -c <config-file>",
    "tinyproxy -d (foreground mode)",
    "tinyproxy -v (version)",
    "tinyproxy -h (help)",
    "tinyproxy -n <fd> (notify readiness)",
    "SIGHUP (garbage collect connections)",
    "SIGUSR1 (reload config and filter list)",
